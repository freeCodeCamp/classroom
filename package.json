{
  "name": "@freecodecamp/classroom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Classroom mode for freeCodeCamp",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.9.1",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecodecamp/classroom.git"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/freecodecamp/classroom/issues"
  },
  "homepage": "https://github.com/freecodecamp/classroom#readme",
  "scripts": {
    "develop": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:challenge-map": "vitest run __tests__/utils/challengeMapUtils.test.ts",
    "challenge-map": "node scripts/build-challenge-map-graphql.ts",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "pnpm run lint:code && pnpm run typecheck && pnpm run lint:pretty",
    "lint:code": "eslint . --cache",
    "lint:pretty": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "mock-fcc-data": "json-server --watch mock-json-server/fccdata.json --port 3002",
    "setup": "node scripts/setup.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@freecodecamp/ui": "6.1.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "json-server": "0.17.1",
    "next": "^16.3.8",
    "next-auth": "4.24.15",
    "nodemailer": "10.0.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-multi-select-component": "4.3.4",
    "react-table": "^7.8.0",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-table": "7.7.20",
    "@types/react-test-renderer": "19.3.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts}": "eslint --cache --fix",
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,css,md,json,yml,yaml}": "prettier --write"
  }
}
