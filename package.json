{
  "name": "@freecodecamp/classroom",
  "version": "0.0.0",
  "private": true,
  "description": "Classroom mode for freeCodeCamp",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.9.1",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecodecamp/classroom.git"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/freecodecamp/classroom/issues"
  },
  "homepage": "https://github.com/freecodecamp/classroom#readme",
  "scripts": {
    "develop": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "test:watch": "jest --watch",
    "test": "jest .",
    "test:challenge-map": "jest __tests__/utils/challengeMapUtils.test.js",
    "challenge-map": "node scripts/build-challenge-map-graphql.mjs",
    "lint": "pnpm run lint:code && pnpm run lint:pretty",
    "lint:code": "eslint . --cache",
    "lint:pretty": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky",
    "mock-fcc-data": "json-server --watch mock-json-server/fccdata.json --port 3002"
  },
  "dependencies": {
    "@freecodecamp/ui": "6.1.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "^6.19.3",
    "json-server": "0.17.1",
    "next": "^16.3.8",
    "next-auth": "4.24.15",
    "nodemailer": "10.0.15",
    "react": "^19.3.0",
    "react-data-table-component": "8.11.0",
    "react-dom": "^19.3.0",
    "react-multi-select-component": "4.3.4",
    "react-table": "^7.8.0",
    "react-tabs": "^6.1.1",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jest": "^29.4.3",
    "jest-environment-jsdom": "^29.4.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "3.3.5",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": "eslint --cache --fix",
    "*.{js,jsx,mjs,cjs,css,md,json,yml,yaml}": "prettier --write"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
