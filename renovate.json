{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>freecodecamp/renovate-config",
    "github>freecodecamp/renovate-config:automerge"
  ],
  "packageRules": [
    {
      "description": "Keep the Node version in .nvmrc and package.json in one PR.",
      "matchPackageNames": ["node"],
      "groupName": "node"
    },
    {
      "description": "Keep the pnpm version in package.json in one PR.",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    }
  ]
}
