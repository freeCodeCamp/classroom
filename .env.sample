# Database. The root docker-compose.yml runs this Postgres.
DATABASE_URL=postgresql://postgres:password@localhost:5432/classroom

# App URL and session secret. Make a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=example-not-for-production
CLASSROOM_APP_BASE_URL=http://localhost:3001

# Auth0. Production requires all three.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=https://example-tenant.auth0.com
DANGEROUS_ACCOUNT_LINKING_ENABLED=false

# GitHub OAuth, for local development only.
GITHUB_OAUTH_PROVIDER_ENABLED=false
GITHUB_ID=
GITHUB_SECRET=

# Student progress data. The mock server (pnpm run mock-fcc-data) is the default.
# Set FCC_API_URL and TPA_API_BEARER_TOKEN to use the freeCodeCamp API instead.
MOCK_USER_DATA_URL=http://localhost:3002/data
FCC_API_URL=
TPA_API_BEARER_TOKEN=

# Email. These values send to Mailpit from docker-compose.yml (http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="freeCodeCamp Classroom <no-reply@classroom.local>"

TEACHER_INVITES_ENABLED=true
