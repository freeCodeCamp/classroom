{
  "name": "freeCodeCamp Classroom",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspaces/classroom",
  "mounts": [
    "source=classroom-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "forwardPorts": [3001, 3002, 8026],
  "portsAttributes": {
    "3001": { "label": "Classroom", "onAutoForward": "notify" },
    "3002": { "label": "Mock fCC data", "onAutoForward": "silent" },
    "8026": { "label": "Mailpit", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },
  "onCreateCommand": ".devcontainer/on-create.sh",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postAttachCommand": ".devcontainer/welcome.sh",
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"]
    }
  },
  "remoteUser": "node"
}
